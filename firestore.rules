rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ユーザー自身のドキュメント
    // プロフィール検索(searchUserByEmail)のため、認証済みユーザー全員に読み取り権限を付与
    // 書き込みは本人のみ（学部・学年・FCMトークンの更新用）
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // サークル関連
    // 全書き込みはAdmin SDK（Server Actions）経由で行うため、クライアント側は読み取りのみ
    match /circles/{circleId} {
      allow read: if request.auth != null;
      allow write: if false;

      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /events/{eventId} {
        allow read: if request.auth != null;
        allow write: if false;

        match /attendance/{attendanceId} {
          allow read: if request.auth != null;
          allow write: if false;
        }

        match /payments/{paymentId} {
          allow read: if request.auth != null;
          allow write: if false;
        }

        match /guests/{guestId} {
          allow read: if request.auth != null;
          allow write: if false;
        }
      }
    }

    // ★ collectionGroupクエリ用（ルートレベルのワイルドカード）— 読み取りのみ
    match /{path=**}/attendance/{docId} {
      allow read: if request.auth != null;
    }

    match /{path=**}/payments/{docId} {
      allow read: if request.auth != null;
    }

    match /{path=**}/members/{docId} {
      allow read: if request.auth != null;
    }

    // 招待コード — Admin SDK経由のみ。クライアントからの読み書き不要
    match /{path=**}/invites/{docId} {
      allow read: if false;
    }

    // 日程調整アンケート — Admin SDK経由のみ
    match /circles/{circleId}/polls/{pollId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /circles/{circleId}/polls/{pollId}/votes/{voteId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // 通知ログ — Admin SDK経由のみ
    match /notificationLogs/{logId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
